---
import BaseLayout from "../layouts/BaseLayout/index.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";

import aboutImage from "../assets/about-step.jpg";
import rocketImage from "../assets/rocket.jpg";
import cansatImage from "../assets/cansat.jpg";

const baseUrl = import.meta.env.BASE_URL;

const sections = [
  {
    title: "宇宙技術プロジェクト STEP",
    description:
      "筑波大学宇宙技術プロジェクトSTEPは、ロケットや模擬人工衛星(CanSat)の製作・運用を行っている学生団体です。",
    image: aboutImage,
    href: `${baseUrl}about`,
  },
  {
    title: "ロケットプロジェクト",
    description:
      "学生自ら設計・製作したハイブリッドロケットの開発を行っています。打上げ実験を通じて、構造設計・エンジン・電装・シミュレーションなど多岐にわたる技術を学びます。",
    image: rocketImage,
    href: `${baseUrl}rocket`,
    reverse: true,
  },
  {
    title: "衛星プロジェクト",
    description:
      "模擬人工衛星「CanSat」の開発を行い、各種コンテストに挑戦しています。機体設計からプログラミングまでを学生主体で取り組み、宇宙機システムの基礎を実践的に学びます。",
    image: cansatImage,
    href: `${baseUrl}cansat`,
  },
];
---

<BaseLayout title="TOP | 筑波大学宇宙技術プロジェクト">
  <Hero hero_title="STEPへようこそ" subtitle="Space TEchnology Project" />

  {
    sections.map((section) => (
      <Section
        title={section.title}
        description={section.description}
        image={section.image}
        href={section.href}
        reverse={section.reverse}
      />
    ))
  }
</BaseLayout>
