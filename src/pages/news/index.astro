---
import BaseLayout from "../../layouts/BaseLayout/index.astro";
import Hero from "../../components/Hero.astro";
import AnimatedSection from "../../components/AnimatedSection.astro";
import {
  formatNewsDate,
  getNewsList,
  localizeImage,
} from "../../lib/microcms";

import newsHeroImage from "../../assets/news.jpg";
const baseUrl = import.meta.env.BASE_URL;

const { contents: newsList } = await getNewsList(100);
---

<BaseLayout title="NEWS | 筑波大学宇宙技術プロジェクト">
  <Hero
    image={newsHeroImage}
    hero_title="NEWS"
    black_opacity={0.3}
    center_or_top="top"
  />

  <div
    class="max-w-5xl mx-auto px-6 sm:px-8 md:px-16 pt-20 pb-20"
  >
    <!-- ニュース一覧 -->
    <div class="space-y-6">
      {
        newsList.map(async (news) => {
          const image = await localizeImage(news.eyecatch);
          return (
            <AnimatedSection>
              <a
                href={`${baseUrl}news/${news.id}`}
                class="news-card block p-6 rounded-lg shadow-lg"
              >
                <div class="w-full h-50 sm:h-62.5 md:h-75 lg:h-87.5 bg-gray-700 rounded-lg overflow-hidden">
                  {image && (
                    <img
                      src={image.url}
                      alt={news.title}
                      class="w-full h-full object-cover"
                      width={image.width}
                      height={image.height}
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                </div>

                <div class="w-full">
                  <h3 class="text-base sm:text-xl md:text-2xl font-bold text-white mt-4">
                    {news.title}
                  </h3>
                  <p class="text-gray-400 text-[0.625rem] sm:text-xs md:text-sm mt-2">
                    {formatNewsDate(news.createdAt)}
                  </p>
                  <p class="text-sm sm:text-base md:text-lg text-gray-300 mt-2">
                    {news.summary}
                  </p>
                </div>
              </a>
            </AnimatedSection>
          );
        })
      }
    </div>
  </div>
</BaseLayout>

<style>
  .news-card {
    transition: transform 0.3s ease-out;
  }

  .news-card:hover {
    transform: scale(1.02);
  }
</style>
