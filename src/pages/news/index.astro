---
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout/index.astro";
import Hero from "../../components/Hero.astro";
import AnimatedSection from "../../components/AnimatedSection.astro";
import { resolveNewsImagePath } from "../../lib/news";

import newsHeroImage from "../../content/news/news-hero.jpg";

// ニュース記事を取得して日付順にソート
const allNews = await getCollection("news");
const sortedNews = allNews.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

// Featured ニュースを取得
const featuredNews = sortedNews.filter((news) => news.data.featured);

// 画像をダイナミックにインポート
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/**/*.{jpg,jpeg,png,gif,webp}",
);

async function getImage(imagePath: string) {
  const imageLoader = images[imagePath];
  if (imageLoader) {
    const image = await imageLoader();
    return image.default;
  }
  return null;
}
---

<BaseLayout title="NEWS | 筑波大学宇宙技術プロジェクト">
  <Hero
    image={newsHeroImage}
    hero_title="NEWS"
    black_opacity={0.3}
    center_or_top="top"
  />

  <div
    class="max-w-7xl mx-auto px-6 sm:px-8 md:px-16 pt-20 pb-20 flex flex-col-reverse lg:grid lg:grid-cols-3 gap-6"
  >
    <!-- ニュース一覧 -->
    <div class="lg:col-span-2 space-y-6">
      {
        sortedNews.map(async (news) => {
          const image = await getImage(
            resolveNewsImagePath(news.data.image, news.id),
          );
          return (
            <AnimatedSection>
              <a
                href={`/news/${news.slug}`}
                class="news-card block p-6 rounded-lg shadow-lg"
              >
                <div class="w-full h-50 sm:h-62.5 md:h-75 lg:h-87.5 bg-gray-700 rounded-lg overflow-hidden">
                  {image && (
                    <Image
                      src={image}
                      alt={news.data.title}
                      class="w-full h-full object-cover"
                      widths={[400, 600, 800, 1200]}
                      sizes="(max-width: 768px) 100vw, (max-width: 1024px) 66vw, 50vw"
                    />
                  )}
                </div>

                <div class="w-full">
                  <h3 class="text-base sm:text-xl md:text-2xl font-bold text-white mt-4">
                    {news.data.title}
                  </h3>
                  <p class="text-gray-400 text-[0.625rem] sm:text-xs md:text-sm mt-2">
                    {news.data.date}
                  </p>
                  <p class="text-sm sm:text-base md:text-lg text-gray-300 mt-2">
                    {news.data.summary}
                  </p>
                </div>
              </a>
            </AnimatedSection>
          );
        })
      }
    </div>

    <!-- Featured News サイドバー -->
    <div class="space-y-6 p-6">
      <h2 class="text-2xl font-bold text-white">Featured News</h2>
      {
        featuredNews.length === 0 ? (
          <p class="text-gray-400">No featured news available</p>
        ) : (
          featuredNews.map((news) => (
            <a
              href={`/news/${news.slug}`}
              class="featured-card block bg-gray-800 p-4 rounded-lg shadow-lg"
            >
              <h3 class="text-sm sm:text-base md:text-lg font-bold text-white">
                {news.data.title}
              </h3>
              <p class="text-gray-400 text-[0.625rem] sm:text-xs md:text-sm">
                {news.data.date}
              </p>
            </a>
          ))
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  .news-card {
    transition: transform 0.3s ease-out;
  }

  .news-card:hover {
    transform: scale(1.02);
  }

  .featured-card {
    transition: transform 0.3s ease-out;
  }

  .featured-card:hover {
    transform: scale(1.05);
  }
</style>
