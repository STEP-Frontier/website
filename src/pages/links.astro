---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout/index.astro";
import logoImage from "../assets/logo.png";
import heroImage from "../assets/links/volubilis-rail.jpg";

const baseUrl = import.meta.env.BASE_URL;

// 名刺の QR などから開く想定のリンク集。ヘッダーのメニューには載せない
const links = [
  {
    label: "STEP公式サイト",
    href: baseUrl,
    icon: "fa:globe",
    external: false,
  },
  {
    label: "X",
    handle: "@Tsukuba_STEP",
    href: "https://x.com/Tsukuba_STEP",
    icon: "fa6-brands:x-twitter",
    external: true,
  },
  {
    label: "Instagram",
    handle: "@tsukuba_step",
    href: "https://www.instagram.com/tsukuba_step",
    icon: "fa6-brands:instagram",
    external: true,
  },
  {
    label: "GitHub",
    handle: "STEP-Frontier",
    href: "https://github.com/STEP-Frontier",
    icon: "fa6-brands:github",
    external: true,
  },
  {
    label: "Mail",
    handle: "step@stb.tsukuba.ac.jp",
    href: "mailto:step@stb.tsukuba.ac.jp",
    icon: "fa:envelope",
    external: false,
  },
];
---

<BaseLayout
  title="LINKS | 筑波大学宇宙技術プロジェクト"
  ogTitle="リンク集 | 筑波大学宇宙技術プロジェクト"
  description="筑波大学宇宙技術プロジェクトSTEPの公式サイトとSNSのリンク集です。"
  bare
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+JP:wght@400;700&display=swap"
    />
  </Fragment>

  <div class="links-page relative min-h-screen overflow-hidden text-white">
    <Image
      src={heroImage}
      alt="ランチャーに載った STEP-19 Volubilis"
      widths={[640, 1108]}
      sizes="100vw"
      loading="eager"
      class="absolute inset-0 w-full h-full object-cover object-[35%_20%]"
    />
    <div class="links-scrim absolute inset-0"></div>

    <div
      class="relative min-h-screen flex flex-col justify-end w-full max-w-md mx-auto px-6 pb-12 md:justify-center md:mr-[8%] md:pb-0"
    >
      <Image
        src={logoImage}
        alt="筑波大学宇宙技術プロジェクト STEP"
        width={311}
        height={100}
        class="w-44 md:w-56 h-auto"
      />
      <p class="mt-4 text-[15px] leading-[1.8] text-white/85">
        筑波大学宇宙技術プロジェクトSTEPは、ロケットや模擬人工衛星(CanSat)の製作・運用を行っている学生団体です。
      </p>

      <ul class="mt-8 border-t border-white/40">
        {
          links.map((link) => (
            <li class="border-b border-white/20">
              <a
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
                class="group flex items-center gap-4 py-4 outline-offset-2 focus-visible:outline-2 focus-visible:outline-white"
              >
                <Icon name={link.icon} class="w-6 h-6 shrink-0" />
                <span class="shrink-0 whitespace-nowrap text-lg font-bold">
                  {link.label}
                </span>
                {link.handle && (
                  <span class="ml-auto min-w-0 truncate text-sm text-white/70 transition-colors duration-150 ease-out group-hover:text-white motion-reduce:transition-none">
                    {link.handle}
                  </span>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</BaseLayout>

<style>
  .links-page {
    font-family: "IBM Plex Sans JP", sans-serif;
    background-color: #0b0f16;
  }

  /* 上は写真の色をそのまま見せ、文字が乗る下側だけ暗くする */
  .links-scrim {
    background: linear-gradient(
      to bottom,
      rgba(8, 11, 18, 0) 0%,
      rgba(8, 11, 18, 0) 16%,
      rgba(8, 11, 18, 0.62) 34%,
      rgba(8, 11, 18, 0.86) 52%,
      rgba(8, 11, 18, 0.92) 100%
    );
  }

  /* PC では右側に文字を置くので、右へ向かって暗くする */
  @media (min-width: 768px) {
    .links-scrim {
      background: linear-gradient(
        to right,
        rgba(8, 11, 18, 0) 0%,
        rgba(8, 11, 18, 0) 35%,
        rgba(8, 11, 18, 0.7) 60%,
        rgba(8, 11, 18, 0.88) 100%
      );
    }
  }
</style>
