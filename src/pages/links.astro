---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout/index.astro";
import logoImage from "../assets/logo.png";

const baseUrl = import.meta.env.BASE_URL;

// 名刺の QR などから開く想定のリンク集。ヘッダーのメニューには載せない
const links = [
  {
    label: "STEP公式サイト",
    handle: "stb.tsukuba.ac.jp/~step",
    href: baseUrl,
    icon: "fa:globe",
    external: false,
  },
  {
    label: "X",
    handle: "@Tsukuba_STEP",
    href: "https://x.com/Tsukuba_STEP",
    icon: "fa6-brands:x-twitter",
    external: true,
  },
  {
    label: "Instagram",
    handle: "@tsukuba_step",
    href: "https://www.instagram.com/tsukuba_step",
    icon: "fa6-brands:instagram",
    external: true,
  },
  {
    label: "GitHub",
    handle: "STEP-Frontier",
    href: "https://github.com/STEP-Frontier",
    icon: "fa6-brands:github",
    external: true,
  },
];
---

<BaseLayout
  title="LINKS | 筑波大学宇宙技術プロジェクト"
  ogTitle="リンク集 | 筑波大学宇宙技術プロジェクト"
  description="筑波大学宇宙技術プロジェクトSTEPの公式サイトとSNSのリンク集です。"
  bare
>
  <div class="min-h-screen flex items-center justify-center px-6 py-16">
    <div class="w-full max-w-md">
      <Image
        src={logoImage}
        alt="筑波大学宇宙技術プロジェクト STEP"
        width={311}
        height={100}
        class="w-40 h-auto"
      />

      <ul class="mt-12 border-t border-gray-800">
        {
          links.map((link) => (
            <li class="border-b border-gray-800">
              <a
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
                class="group flex items-center gap-4 py-5 text-white outline-offset-4 focus-visible:outline-2 focus-visible:outline-white"
              >
                <Icon
                  name={link.icon}
                  class="w-5 h-5 shrink-0 text-gray-500 transition-colors duration-150 ease-out group-hover:text-white motion-reduce:transition-none"
                />
                <span class="text-base font-bold">{link.label}</span>
                <span class="ml-auto min-w-0 truncate text-sm text-gray-400 transition-colors duration-150 ease-out group-hover:text-white motion-reduce:transition-none">
                  {link.handle}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</BaseLayout>
