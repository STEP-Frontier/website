---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout/index.astro";
import logoImage from "../assets/logo.png";
import heroImage from "../assets/links/volubilis-rail.jpg";

const baseUrl = import.meta.env.BASE_URL;

// 名刺の QR などから開く想定のリンク集。ヘッダーのメニューには載せない
const links = [
  {
    label: "STEP公式サイト",
    href: baseUrl,
    icon: "fa:globe",
    external: false,
  },
  {
    label: "X",
    handle: "@Tsukuba_STEP",
    href: "https://x.com/Tsukuba_STEP",
    icon: "fa6-brands:x-twitter",
    external: true,
  },
  {
    label: "Instagram",
    handle: "@tsukuba_step",
    href: "https://www.instagram.com/tsukuba_step",
    icon: "fa6-brands:instagram",
    external: true,
  },
  {
    label: "GitHub",
    handle: "STEP-Frontier",
    href: "https://github.com/STEP-Frontier",
    icon: "fa6-brands:github",
    external: true,
  },
  {
    label: "Mail",
    handle: "step@stb.tsukuba.ac.jp",
    href: "mailto:step@stb.tsukuba.ac.jp",
    icon: "fa:envelope",
    external: false,
  },
];
---

<BaseLayout
  title="LINKS | 筑波大学宇宙技術プロジェクト"
  ogTitle="リンク集 | 筑波大学宇宙技術プロジェクト"
  description="筑波大学宇宙技術プロジェクトSTEPの公式サイトとSNSのリンク集です。"
  bare
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+JP:wght@400;700&display=swap"
    />
  </Fragment>

  <div class="links-page min-h-screen text-[#0e1a2b] md:flex">
    <div
      class="relative h-[34vh] min-h-56 max-h-[520px] overflow-hidden md:h-screen md:max-h-none md:w-1/2 md:sticky md:top-0"
    >
      <Image
        src={heroImage}
        alt="ランチャーに載った STEP-19 Volubilis"
        widths={[640, 1108]}
        sizes="(max-width: 768px) 100vw, 50vw"
        loading="eager"
        class="w-full h-full object-cover object-[50%_35%]"
      />
    </div>

    <div
      class="w-full max-w-md mx-auto px-6 pt-10 pb-16 md:self-center md:py-16"
    >
      <Image
        src={logoImage}
        alt="筑波大学宇宙技術プロジェクト STEP"
        width={311}
        height={100}
        class="w-44 md:w-56 h-auto brightness-0"
      />
      <p class="mt-5 text-[15px] leading-[1.8] text-[#3d4a5c]">
        筑波大学宇宙技術プロジェクトSTEPは、ロケットや模擬人工衛星(CanSat)の製作・運用を行っている学生団体です。
      </p>

      <ul class="mt-8 border-t-2 border-[#0e1a2b]">
        {
          links.map((link) => (
            <li class="border-b border-[#0e1a2b]/25">
              <a
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
                class="group flex items-center gap-4 py-4 outline-offset-2 focus-visible:outline-2 focus-visible:outline-[#2f5fa8]"
              >
                <Icon
                  name={link.icon}
                  class="w-6 h-6 shrink-0 text-[#2f5fa8]"
                />
                <span class="shrink-0 whitespace-nowrap text-lg font-bold transition-colors duration-150 ease-out group-hover:text-[#2f5fa8] motion-reduce:transition-none">
                  {link.label}
                </span>
                {link.handle && (
                  <span class="mono ml-auto min-w-0 truncate text-sm text-[#3d4a5c]">
                    {link.handle}
                  </span>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</BaseLayout>

<style>
  .links-page {
    font-family: "IBM Plex Sans JP", sans-serif;
    /* 製図用紙の方眼：細線 8px、太線 40px */
    background-color: #f4f7fb;
    background-image:
      linear-gradient(rgba(47, 95, 168, 0.14) 1px, transparent 1px),
      linear-gradient(90deg, rgba(47, 95, 168, 0.14) 1px, transparent 1px),
      linear-gradient(rgba(47, 95, 168, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(47, 95, 168, 0.06) 1px, transparent 1px);
    background-size:
      40px 40px,
      40px 40px,
      8px 8px,
      8px 8px;
  }

  .mono {
    font-family: "IBM Plex Mono", "IBM Plex Sans JP", monospace;
    font-variant-numeric: tabular-nums;
  }
</style>
