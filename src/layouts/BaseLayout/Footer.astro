---
import { Icon } from 'astro-icon/components'
---

<footer class="bg-gray-900 text-gray-300 py-10">
    <div class="max-w-7xl mx-auto px-8 sm:px-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-10">
            <div>
                <h3
                    class="text-base sm:text-lg md:text-xl font-bold text-white mb-2"
                >
                    Our Address
                </h3>
                <p class="text-xs sm:text-sm md:text-base">
                    筑波大学 宇宙技術プロジェクト STEP
                </p>
                <p class="text-xs sm:text-sm md:text-base">
                    1-1-1 Tennodai, Tsukuba, Ibaraki, Japan
                </p>
            </div>

            <div>
                <h3
                    class="text-base sm:text-lg md:text-xl font-bold text-white mb-2"
                >
                    Contact
                </h3>
                <p class="text-xs sm:text-sm md:text-base">
                    Email: <a
                        href="mailto:step@stb.tsukuba.ac.jp"
                        class="hover:text-white transition"
                        >step@stb.tsukuba.ac.jp</a
                    >
                </p>
            </div>

            <div>
                <h3
                    class="text-base sm:text-lg md:text-xl font-bold text-white mb-2"
                >
                    Follow Us
                </h3>
                <div class="flex space-x-6">
                    <a
                        href="https://x.com/Tsukuba_STEP"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hover:text-white transition text-2xl"
                    >
                        <Icon name="fa6-brands:x-twitter" />
                    </a>
                    <a
                        href="https://www.instagram.com/tsukuba_step"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hover:text-white transition text-2xl"
                    >
                        <Icon name="fa:instagram" />
                    </a>
                </div>
            </div>
        </div>

        <div
            class="mt-10 text-center text-[0.625rem] sm:text-xs md:text-sm text-gray-400"
        >
            © {new Date().getFullYear()} STEP - Tsukuba Space TEchnology Project.
            All Rights Reserved.
        </div>
    </div>
</footer>
