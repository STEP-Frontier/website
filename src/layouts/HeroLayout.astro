---
import Hero from "../components/Hero.astro";
import BaseLayout from "./BaseLayout/index.astro";

export interface Props {
  title: string;
  hero_title?: string;
}

const { title, hero_title } = Astro.props;
---

<BaseLayout title={`${title} | 筑波大学宇宙技術プロジェクト`}>
  <Hero hero_title={hero_title ?? title} />
  <slot />
</BaseLayout>
