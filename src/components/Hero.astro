---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import defaultHeroImage from "../assets/hero.jpg";

interface Props {
  image?: ImageMetadata;
  hero_title?: string;
  subtitle?: string | false;
  black_opacity?: number;
  center_or_top?: "center" | "top";
}

const {
  image = defaultHeroImage,
  hero_title = "STEPへようこそ",
  subtitle = false,
  black_opacity = 0.3,
  center_or_top = "center",
} = Astro.props;

const objectPosition = center_or_top === "top" ? "top" : "center";
---

<div class="hero-container relative h-screen overflow-hidden">
  <!-- 背景画像 -->
  <Image
    src={image}
    alt="Hero background"
    class="absolute inset-0 w-full h-full object-cover"
    style={`object-position: ${objectPosition};`}
    widths={[640, 1024, 1920, 2560]}
    sizes="100vw"
    loading="eager"
  />

  <!-- 黒色オーバーレイ -->
  <div
    class="absolute inset-0"
    style={`background-color: rgba(0, 0, 0, ${black_opacity});`}
  >
  </div>

  <!-- コンテンツエリア -->
  <div
    class="relative flex flex-col h-full items-center justify-center text-center text-white"
  >
    <h1
      class="hero-title text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold"
    >
      {hero_title}
    </h1>

    <!-- サブタイトル（オプション） -->
    {
      subtitle && (
        <p class="hero-subtitle mt-4 text-sm sm:text-base md:text-lg max-w-xl font-bold">
          {subtitle}
        </p>
      )
    }

    <!-- 下向き矢印 -->
    <div class="hero-arrow absolute bottom-10 animate-bounce">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="15.5"
        height="20.2"
        fill="white"
        class="svg-arrow-down"
      >
        <path d="M0 12.4l7.8 7.8 7.7-7.8-1-1-6 6V0H7v17.4l-6-6z"></path>
      </svg>
    </div>
  </div>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const arrow = document.querySelector(".hero-arrow") as HTMLElement;

    if (!arrow) return;

    const handleScroll = () => {
      const maxScroll = 300;
      let newOpacity = 1 - window.scrollY / maxScroll;
      if (newOpacity < 0) newOpacity = 0;
      arrow.style.opacity = String(newOpacity);
    };

    window.addEventListener("scroll", handleScroll);
  });
</script>

<style>
  .hero-title {
    opacity: 0;
    transform: translateY(-50px);
    animation: fadeInDown 1s ease-out forwards;
  }

  .hero-subtitle {
    opacity: 0;
    animation: fadeIn 1.5s ease-out forwards;
    animation-delay: 0.5s;
  }

  @keyframes fadeInDown {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeIn {
    to {
      opacity: 1;
    }
  }
</style>
