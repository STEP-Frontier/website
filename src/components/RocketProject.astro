---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  name: string;
  specs: string[];
  description: string;
  results: string;
  images: [ImageMetadata, ImageMetadata];
}

const { name, specs, description, results, images } = Astro.props;
---

<section
  class="rocket-project py-20 px-6 sm:px-8 md:px-16 max-w-[90rem] mx-auto"
>
  <!-- プロジェクトタイトル -->
  <div class="text-center mb-10">
    <h2
      class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-white"
    >
      {name}
    </h2>
  </div>

  <!-- 機体概要 -->
  <div class="rocket-section flex flex-col lg:flex-row items-center gap-10">
    <div class="lg:w-1/2 text-left">
      <h3 class="text-2xl sm:text-3xl md:text-4xl font-bold text-white mb-4">
        機体概要
      </h3>
      <p class="text-sm sm:text-base md:text-lg text-gray-300 mt-4 mb-4">
        {description}
      </p>
      <ul class="text-sm sm:text-base md:text-lg text-gray-300 space-y-1">
        {specs.map((spec) => <li>{spec}</li>)}
      </ul>
    </div>
    <div class="lg:w-1/2">
      <Image
        src={images[0]}
        alt={`${name} 機体`}
        class="shadow-lg w-full object-cover rounded-lg"
        widths={[400, 600, 800, 1200]}
        sizes="(max-width: 1024px) 100vw, 50vw"
      />
    </div>
  </div>

  <!-- 実験結果 -->
  <div
    class="rocket-section flex flex-col lg:flex-row-reverse items-center gap-10 mt-20"
  >
    <div class="lg:w-1/2 text-left">
      <h3 class="text-2xl sm:text-3xl md:text-4xl font-bold text-white mb-4">
        実験結果
      </h3>
      <p class="text-sm sm:text-base md:text-lg text-gray-300">
        {
          results.split("\n").map((line) => (
            <>
              {line}
              <br />
            </>
          ))
        }
      </p>
    </div>
    <div class="lg:w-1/2">
      <Image
        src={images[1]}
        alt={`${name} 実験`}
        class="shadow-lg w-full object-cover rounded-lg"
        widths={[400, 600, 800, 1200]}
        sizes="(max-width: 1024px) 100vw, 50vw"
      />
    </div>
  </div>
</section>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll(".rocket-section");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("rocket-section-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 },
    );

    sections.forEach((section) => {
      observer.observe(section);
    });
  });
</script>

<style>
  .rocket-section {
    opacity: 0;
    transform: translateY(50px);
    transition:
      opacity 1s ease-out,
      transform 1s ease-out;
  }

  .rocket-section.rocket-section-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>
