---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  description: string;
  image: ImageMetadata;
  reverse?: boolean;
  href?: string;
}

const { title, description, image, reverse = false, href } = Astro.props;
---

<div
  class:list={[
    "section-container flex flex-col items-center py-20",
    "px-6 sm:px-8 md:px-12 lg:px-16",
    "max-w-7xl mx-auto",
    "md:flex-row",
    { "md:flex-row-reverse": reverse },
  ]}
>
  <div class="md:w-1/2">
    <Image
      src={image}
      alt={title}
      class="w-full rounded-lg shadow-lg"
      widths={[400, 800, 1200]}
      sizes="(max-width: 768px) 100vw, 50vw"
    />
  </div>
  <div class="md:m-5"></div>
  <div class="md:w-1/2 md:mb-0 mb-5">
    <h2 class="text-xl sm:text-2xl md:text-3xl font-bold mb-4 text-white">
      {title}
    </h2>
    <p class="text-sm sm:text-base md:text-lg text-gray-300">{description}</p>
    {
      href && (
        <div class="text-center md:text-left">
          <a href={href}>
            <button class="mt-4 px-6 sm:px-7 md:px-8 py-1 border-2 border-gray-700 text-gray-500 text-xs sm:text-sm md:text-base rounded-full transition duration-300 ease-in-out hover:border-blue-800 hover:text-white hover:cursor-pointer">
              Learn More
            </button>
          </a>
        </div>
      )
    }
  </div>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll(".section-container");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("section-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 },
    );

    sections.forEach((section) => {
      observer.observe(section);
    });
  });
</script>

<style>
  .section-container {
    opacity: 0;
    transform: translateY(50px);
    transition:
      opacity 1s ease-out,
      transform 1s ease-out;
  }

  .section-container.section-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>
