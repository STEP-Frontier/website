---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  name: string;
  logo: ImageMetadata;
  logoBackground?: "light" | "dark" | "none";
  url?: string;
  description?: string;
  publishedAt?: Date;
}

const {
  name,
  logo,
  logoBackground = "light",
  url,
  description,
  publishedAt,
} = Astro.props;

// published_at があるときは非表示で出力し、その日時を過ぎたらブラウザ側で表示に切り替える
const publishedAtIso = publishedAt
  ? new Date(publishedAt).toISOString()
  : undefined;

// url があるときだけ行全体をリンクにする
const Tag = url ? "a" : "div";
const linkProps = url
  ? {
      href: url,
      target: "_blank",
      rel: "noopener noreferrer",
      "aria-label": `${name}の公式サイト（新しいタブで開く）`,
    }
  : {};

const logoBackgroundClass = {
  light: "bg-white",
  dark: "bg-black border border-gray-800",
  none: "",
}[logoBackground];

// SVG は Astro の画像最適化を通さずそのまま表示する
const isSvg = logo.format === "svg";
---

<div
  class:list={[
    "sponsor-row border-b border-gray-800",
    { "sponsor-row-scheduled": publishedAtIso },
  ]}
  data-published-at={publishedAtIso}
>
  <Tag
    {...linkProps}
    class:list={[
      "flex flex-col md:flex-row items-center gap-8 md:gap-14 py-12 md:py-16 px-2 rounded-lg",
      "transition duration-300 ease-in-out",
      { "hover:bg-white/5": url },
    ]}
  >
    <div class="w-full md:w-2/5 shrink-0">
      <div
        class:list={[
          "flex items-center justify-center w-full h-40 md:h-52 rounded-lg overflow-hidden p-6",
          logoBackgroundClass,
        ]}
      >
        {
          isSvg ? (
            <img
              src={logo.src}
              alt={`${name}のロゴ`}
              class="max-h-full max-w-full w-auto object-contain"
            />
          ) : (
            <Image
              src={logo}
              alt={`${name}のロゴ`}
              class="max-h-full max-w-full w-auto object-contain"
              widths={[300, 600]}
              sizes="(max-width: 768px) 80vw, 400px"
            />
          )
        }
      </div>
    </div>

    <div class="w-full md:w-3/5">
      <h2 class="text-xl sm:text-2xl md:text-3xl font-bold text-white">
        {name}
      </h2>
      {
        description && (
          <p class="text-sm sm:text-base md:text-lg text-gray-300 mt-4">
            {description}
          </p>
        )
      }
    </div>
  </Tag>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    // 公開日時を過ぎているカードだけ非表示を解除する
    document.querySelectorAll(".sponsor-row-scheduled").forEach((row) => {
      const publishedAt = Date.parse(
        row.getAttribute("data-published-at") ?? "",
      );
      if (!Number.isNaN(publishedAt) && Date.now() >= publishedAt) {
        row.classList.remove("sponsor-row-scheduled");
      }
    });

    const rows = document.querySelectorAll(".sponsor-row");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("sponsor-row-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 },
    );

    rows.forEach((row) => {
      observer.observe(row);
    });
  });
</script>

<style>
  .sponsor-row {
    opacity: 0;
    transform: translateY(50px);
    transition:
      opacity 1s ease-out,
      transform 1s ease-out;
  }

  .sponsor-row.sponsor-row-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* 公開日時前のカードは領域ごと出さない */
  .sponsor-row.sponsor-row-scheduled {
    display: none;
  }

  .sponsor-row:last-child {
    border-bottom: none;
  }

  /* 末尾が非表示のときは、その手前を最後の行として扱う */
  .sponsor-row:has(+ .sponsor-row-scheduled:last-child) {
    border-bottom: none;
  }
</style>
