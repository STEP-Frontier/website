---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  name: string;
  logo: ImageMetadata;
  logoBackground?: "light" | "dark" | "none";
  url?: string;
  description?: string;
}

const { name, logo, logoBackground = "light", url, description } = Astro.props;

// url があるときだけカード全体をリンクにする
const Tag = url ? "a" : "div";
const linkProps = url
  ? {
      href: url,
      target: "_blank",
      rel: "noopener noreferrer",
      "aria-label": `${name}の公式サイト（新しいタブで開く）`,
    }
  : {};

const logoBackgroundClass = {
  light: "bg-white",
  dark: "bg-black border border-gray-800",
  none: "",
}[logoBackground];

// SVG は Astro の画像最適化を通さずそのまま表示する
const isSvg = logo.format === "svg";
---

<div class="sponsor-card h-full">
  <Tag
    {...linkProps}
    class:list={[
      "flex flex-col h-full p-6 sm:p-8 rounded-lg text-center",
      "border-2 border-gray-800 bg-white/5",
      "transition duration-300 ease-in-out",
      { "hover:border-blue-800 hover:bg-white/10": url },
    ]}
  >
    <div
      class:list={[
        "flex items-center justify-center w-full h-28 sm:h-32 rounded-lg overflow-hidden p-4 mb-5",
        logoBackgroundClass,
      ]}
    >
      {
        isSvg ? (
          <img
            src={logo.src}
            alt={`${name}のロゴ`}
            class="max-h-full max-w-full w-auto object-contain"
          />
        ) : (
          <Image
            src={logo}
            alt={`${name}のロゴ`}
            class="max-h-full max-w-full w-auto object-contain"
            widths={[200, 400]}
            sizes="(max-width: 768px) 60vw, 300px"
          />
        )
      }
    </div>

    <h3 class="text-base sm:text-lg md:text-xl font-bold text-white">{name}</h3>

    {
      description && (
        <p class="text-sm sm:text-base text-gray-300 mt-3">{description}</p>
      )
    }
  </Tag>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const cards = document.querySelectorAll(".sponsor-card");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("sponsor-card-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 },
    );

    cards.forEach((card) => {
      observer.observe(card);
    });
  });
</script>

<style>
  .sponsor-card {
    opacity: 0;
    transform: translateY(50px);
    transition:
      opacity 1s ease-out,
      transform 1s ease-out;
  }

  .sponsor-card.sponsor-card-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>
